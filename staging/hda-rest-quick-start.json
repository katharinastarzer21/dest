{HDA_API_URL}/stac/v2\"\n\n## Collections\nCOLLECTIONS_URL = f\"{STAC_API_URL}/collections\"\nCOLLECTION_BY_ID_URL = f\"{COLLECTIONS_URL}/{COLLECTION_ID}\"\n\n## Items\nCOLLECTION_ITEMS_URL = f\"{COLLECTIONS_URL}/{COLLECTION_ID}/items\"\n\n## Item Search\nSEARCH_URL = f\"{STAC_API_URL}/search\"\n\n## HTTP Success\nHTTP_SUCCESS_CODE = 200","visibility":"show","key":"z9TvWO9mGt"},{"type":"outputs","id":"pl1cZ-jhN5ObAlaBzKywY","children":[],"visibility":"show","key":"XWyJX39GUb"}],"visibility":"show","key":"NUDKkuIB0K"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Discover data","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Nea9J1gRnE"}],"identifier":"discover-data","label":"Discover data","html_id":"discover-data","implicit":true,"key":"h0K6bV0xYO"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Below an example for discovering collections concerning Chlorophyll-a Concentration and algal pigment.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"RU93Oz7kfY"}],"key":"P2xS2GwvCv"}],"key":"tR3M8xUYbJ"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"response = requests.get(COLLECTIONS_URL,params = {\"q\": \"Chlorophyll-a Concentration,algal pigment\"})\n\nJSON(response.json(), expanded=False)","visibility":"show","key":"sALcGLleSP"},{"type":"outputs","id":"a3jlJzU1VX8nNsP6J6m1k","children":[{"type":"output","jupyter_data":{"output_type":"execute_result","execution_count":5,"metadata":{"application/json":{"expanded":false,"root":"root"}},"data":{"application/json":{"content_type":"application/json","hash":"2838aaecfbddd61c0156565a94a33384","path":"/2838aaecfbddd61c0156565a94a33384.json"},"text/plain":{"content":"<