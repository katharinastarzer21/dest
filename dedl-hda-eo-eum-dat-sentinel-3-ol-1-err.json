lize data","html_id":"visualize-data","implicit":true,"key":"rJ1I4tdXCy"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"We can visualize the available datasets on a map.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"rAYUMRrSyC"}],"key":"MluECTfaVb"}],"key":"hUaLAiotVB"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"import matplotlib.pyplot as plt\nfrom pyresample.kd_tree import resample_nearest\nfrom pyresample.geometry import AreaDefinition\n","visibility":"show","key":"aBPzfYPMiv"},{"type":"output","id":"gomMPjvXtefBBA0hCb6qZ","data":[],"visibility":"show","key":"b05EG6RwVr"}],"visibility":"show","key":"KTjiziNNaM"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"#area definition\narea_id = 'worldeqc30km'\ndescription = 'World in 3km, platecarree'\nproj_id = 'eqc'\nprojection = {'proj': 'eqc', 'ellps': 'WGS84'}\nwidth = 820\nheight = 410\narea_extent = (-20037508.3428, -10018754.1714, 20037508.3428, 10018754.1714)\narea_def = AreaDefinition(area_id, description, proj_id, projection,\n                          width, height, area_extent)\n\n#scene \nlons, lats = scn[\"total_ozone\"].area.get_lonlats()\nswath_def = pyresample.geometry.SwathDefinition(lons, lats)\ntotal_ozone = scn[\"total_ozone\"].data.compute()\nresult = resample_nearest(swath_def, total_ozone, area_def, radius_of_influence=20000, fill_value=None)\n\n#cartopy\nplt.rcParams['figure.figsize'] = [15, 15]\ncrs = area_def.to_cartopy_crs()\nfig, ax = plt.subplots(subplot_kw=dict(projection=crs))\ncoastlines = ax.coastlines()  \nax.set_global()\n\n#plot\nimg = plt.imshow(result, transform=crs, extent=crs.bounds, origin='upper')\n# Calculate (height_of_image / width_of_image)\nim_ratio = result.shape[0]/result.shape[1]\n \n# Plot vertical colorbar\nplt.colorbar(fraction=0.047*im_ratio)\nplt.show()","visibility":"show","key":"zCvyWblNMi"},{"type":"output","id":"sfiY6Ve6JzCBfnPjGAcEL","data":[{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"45047adaed96e057d4551d262ff30e65","path":"/dest/build/45047adaed96e057d4551d262ff30e65.png"},"text/plain":{"content":"<Figure size 1500x1500 with 2 Axes>","content_type":"text/plain"}}}],"visibility":"show","key":"yj6m268v1F"}],"visibility":"show","key":"MfNampgxO1"}],"key":"Ig9tOk89iN"},"references":{"cite":{"order":[],"data":{}}},"footer":{},"domain":"http://localhost:3000"}