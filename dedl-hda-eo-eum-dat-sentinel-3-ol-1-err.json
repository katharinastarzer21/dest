cal colorbar\nplt.colorbar(fraction=0.047*im_ratio)\nplt.show()","visibility":"show","key":"rBuWSXwsSG"},{"type":"output","id":"3853yO2CUnZ4fBSqnLVco","data":[{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"45047adaed96e057d4551d262ff30e65","path":"/dest/build/45047adaed96e057d4551d262ff30e65.png"},"text/plain":{"content":"<Figure size 1500x1500 with 2 Axes>","content_type":"text/plain"}}}],"visibility":"show","key":"UGEZmE0yDv"}],"visibility":"show","key":"tWJtv5vrH0"}],"key":"nIQqDmOAIU"},"references":{"cite":{"order":[],"data":{}}},"footer":{},"domain":"http://localhost:3000"}