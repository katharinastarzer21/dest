/stac/v2\"\n\n## Collections\nCOLLECTIONS_URL = f\"{STAC_API_URL}/collections\"\nCOLLECTION_BY_ID_URL = f\"{COLLECTIONS_URL}/{COLLECTION_ID}\"\n\n## Items\nCOLLECTION_ITEMS_URL = f\"{COLLECTIONS_URL}/{COLLECTION_ID}/items\"\n\n## Item Search\nSEARCH_URL = f\"{STAC_API_URL}/search\"\n\n## HTTP Success\nHTTP_SUCCESS_CODE = 200","visibility":"show","key":"gRVqkfs2gh"},{"type":"output","id":"xWFdkdBzGkx_3SH-Y0VR2","data":[],"visibility":"show","key":"GMj2hFEQmp"}],"visibility":"show","key":"qjNjGpGtKC"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Discover data","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"TWyBR5Lis5"}],"identifier":"discover-data","label":"Discover data","html_id":"discover-data","implicit":true,"key":"nbKhYitdiR"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Below an example for discovering collections concerning Chlorophyll-a Concentration and algal pigment.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"VmJnlg0uMz"}],"key":"ox5bFHJ6Dv"}],"key":"zNTe18cxeG"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"response = requests.get(COLLECTIONS_URL,params = {\"q\": \"Chlorophyll-a Concentration,algal pigment\"})\n\nJSON(response.json(), expanded=False)","visibility":"show","key":"J0Ph1Z7veb"},{"type":"output","id":"0QqBSUxnDbw3EFPNp2nNx","data":[{"output_type":"execute_result","execution_count":5,"metadata":{"application/json":{"expanded":false,"root":"root"}},"data":{"application/json":{"content_type":"application/json","hash":"2838aaecfbddd61c0156565a94a33384","path":"/dest/build/2838aaecfbddd61c0156565a94a33384.json"},"text/plain":{"content":"<IPython.core.display.JSON object>","content_