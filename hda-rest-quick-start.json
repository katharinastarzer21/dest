/stac/v2\"\n\n## Collections\nCOLLECTIONS_URL = f\"{STAC_API_URL}/collections\"\nCOLLECTION_BY_ID_URL = f\"{COLLECTIONS_URL}/{COLLECTION_ID}\"\n\n## Items\nCOLLECTION_ITEMS_URL = f\"{COLLECTIONS_URL}/{COLLECTION_ID}/items\"\n\n## Item Search\nSEARCH_URL = f\"{STAC_API_URL}/search\"\n\n## HTTP Success\nHTTP_SUCCESS_CODE = 200","visibility":"show","key":"FCVovSXVZT"},{"type":"output","id":"pmPcaEiKOw9LdgDH-Jsi4","data":[],"visibility":"show","key":"g1Az6T1e1x"}],"visibility":"show","key":"KNxyixv79V"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Discover data","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"P3RIeRgNme"}],"identifier":"discover-data","label":"Discover data","html_id":"discover-data","implicit":true,"key":"cbVf7QhEms"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Below an example for discovering collections concerning Chlorophyll-a Concentration and algal pigment.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"bJmJnXZJGp"}],"key":"gKvYus29xB"}],"key":"JZJCobFtbc"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"response = requests.get(COLLECTIONS_URL,params = {\"q\": \"Chlorophyll-a Concentration,algal pigment\"})\n\nJSON(response.json(), expanded=False)","visibility":"show","key":"sPY83viz11"},{"type":"output","id":"50qp9hmGbUxj4R5rhYa3M","data":[{"output_type":"execute_result","execution_count":5,"metadata":{"application/json":{"expanded":false,"root":"root"}},"data":{"application/json":{"content_type":"application/json","hash":"2838aaecfbddd61c0156565a94a33384","path":"/dest/build/2838aaecfbddd61c0156565a94a33384.json"},"text/plain":{"content":"<IPython.core.display.JSON object>","content_