e, 'wb') as f:\n            for chunk in response.iter_content(chunk_size=1024): \n                if chunk:\n                    f.write(chunk)\n                    f.flush()\n        print(\"The dataset has been downloaded to: {}\".format(filename))\nelse: print(\"Request Unsuccessful! Error-Code: {}\".format(response.status_code))","visibility":"show","key":"U1W6Zw4qZQ"},{"type":"output","id":"ynuP1lI3lZGPGpjvEcN_j","data":[{"name":"stdout","output_type":"stream","text":"Downloading ...\nThe dataset has been downloaded to: S3A_OL_2_WRR____20240909T130929_20240909T135342_20240910T163350_2653_116_352______MAR_O_NT_003.SEN3.zip\n"}],"visibility":"show","key":"UMrD6gK7cP"}],"visibility":"show","key":"VWMNAYUygS"}],"key":"AKQVzmMQEk"},"references":{"cite":{"order":[],"data":{}}},"footer":{},"domain":"http://localhost:3000"}