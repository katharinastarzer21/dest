e, 'wb') as f:\n            for chunk in response.iter_content(chunk_size=1024): \n                if chunk:\n                    f.write(chunk)\n                    f.flush()\n        print(\"The dataset has been downloaded to: {}\".format(filename))\nelse: print(\"Request Unsuccessful! Error-Code: {}\".format(response.status_code))","visibility":"show","key":"Klt8rgtlPX"},{"type":"output","id":"mNwTpybO10z55CF1bI0s8","data":[{"name":"stdout","output_type":"stream","text":"Downloading ...\nThe dataset has been downloaded to: S3A_OL_2_WRR____20240909T130929_20240909T135342_20240910T163350_2653_116_352______MAR_O_NT_003.SEN3.zip\n"}],"visibility":"show","key":"uAGZuJifmc"}],"visibility":"show","key":"j4QICKxLnB"}],"key":"ksLKLV50Qs"},"references":{"cite":{"order":[],"data":{}}},"footer":{},"domain":"http://localhost:3000"}